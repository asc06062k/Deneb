{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Workshop step CH06-S03 - connector rule between Actual and Reference per category. Generated by qa/scripts/build-workshop-steps.mjs from specs/dual-line-variance-final.vl.json (do not hand-edit; edit the final spec or the generator).",
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "data": {
    "name": "dataset"
  },
  "params": [
    {
      "name": "xAxisCategories",
      "expr": "pluck(data('dataset'), 'Category')"
    },
    {
      "name": "xAxisValues",
      "expr": "length(xAxisCategories) > 0 && length(xAxisCategories) <= 1000 ? sequence(1, length(xAxisCategories) + 1) : []"
    },
    {
      "name": "yActualValues",
      "expr": "pluck(data('dataset'), 'Actual')"
    },
    {
      "name": "yReferenceValues",
      "expr": "pluck(data('dataset'), 'Reference')"
    },
    {
      "name": "yHasBlank",
      "expr": "indexof(yActualValues, null) >= 0 || indexof(yReferenceValues, null) >= 0"
    },
    {
      "name": "yRawMin",
      "expr": "min(extent(yActualValues)[0], extent(yReferenceValues)[0], yHasBlank ? 0 : MAX_VALUE)"
    },
    {
      "name": "yRawMax",
      "expr": "max(extent(yActualValues)[1], extent(yReferenceValues)[1], yHasBlank ? 0 : -MAX_VALUE)"
    },
    {
      "name": "yPad",
      "expr": "(yRawMax - yRawMin) * 0.18 || abs(yRawMax) * 0.1 || 1"
    },
    {
      "name": "yDomainMin",
      "expr": "isFinite(yRawMin) ? yRawMin - yPad : 0"
    },
    {
      "name": "yDomainMax",
      "expr": "isFinite(yRawMax) ? max(yRawMax + yPad, yDomainMin + 1) : 1"
    }
  ],
  "transform": [
    {
      "calculate": "isValid(datum.Actual) ? datum.Actual : 0",
      "as": "Actual"
    },
    {
      "calculate": "isValid(datum.Reference) ? datum.Reference : 0",
      "as": "Reference"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "Position"
        }
      ]
    },
    {
      "window": [
        {
          "op": "lead",
          "field": "Actual",
          "as": "NextActual"
        },
        {
          "op": "lead",
          "field": "Reference",
          "as": "NextReference"
        }
      ]
    },
    {
      "calculate": "datum.Actual - datum.Reference",
      "as": "Diff"
    },
    {
      "calculate": "datum.NextActual - datum.NextReference",
      "as": "NextDiff"
    },
    {
      "calculate": "datum.Diff != 0 ? (datum.Diff > 0 ? 1 : -1) : (datum.NextDiff > 0 ? 1 : datum.NextDiff < 0 ? -1 : 0)",
      "as": "RunSign"
    },
    {
      "calculate": "datum.Diff * datum.NextDiff < 0 ? datum.Diff / (datum.Diff - datum.NextDiff) : 0",
      "as": "CrossT"
    },
    {
      "calculate": "datum.Actual + datum.CrossT * (datum.NextActual - datum.Actual)",
      "as": "CrossY"
    },
    {
      "calculate": "datum.CrossT > 0 ? [ {x: datum.Position, actual: datum.Actual, reference: datum.Reference, part: 'a', sign: datum.RunSign}, {x: datum.Position + datum.CrossT, actual: datum.CrossY, reference: datum.CrossY, part: 'a', sign: datum.RunSign}, {x: datum.Position + datum.CrossT, actual: datum.CrossY, reference: datum.CrossY, part: 'b', sign: -datum.RunSign}, {x: datum.Position + 1, actual: datum.NextActual, reference: datum.NextReference, part: 'b', sign: -datum.RunSign} ] : [ {x: datum.Position, actual: datum.Actual, reference: datum.Reference, part: '', sign: datum.RunSign}, {x: datum.Position + 1, actual: datum.NextActual, reference: datum.NextReference, part: '', sign: datum.RunSign} ]",
      "as": "Vertices"
    }
  ],
  "layer": [
    {
      "name": "variance_area",
      "transform": [
        {
          "filter": "isValid(datum.NextActual)"
        },
        {
          "flatten": [
            "Vertices"
          ],
          "as": [
            "Vertex"
          ]
        },
        {
          "calculate": "datum.Position + '-' + datum.Vertex.part",
          "as": "Segment"
        }
      ],
      "mark": {
        "type": "area",
        "opacity": 0.15,
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "Vertex.x",
          "type": "quantitative"
        },
        "y": {
          "field": "Vertex.actual",
          "type": "quantitative"
        },
        "y2": {
          "field": "Vertex.reference"
        },
        "detail": {
          "field": "Segment",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "(datum.Business_Type == 'Higher is Good' && datum.Vertex.sign > 0) || (datum.Business_Type == 'Lower is Good' && datum.Vertex.sign < 0)",
            "value": "#0F766E"
          },
          "value": "#B45309"
        },
        "stroke": {
          "condition": {
            "test": "(datum.Business_Type == 'Higher is Good' && datum.Vertex.sign > 0) || (datum.Business_Type == 'Lower is Good' && datum.Vertex.sign < 0)",
            "value": "#0F766E"
          },
          "value": "#B45309"
        },
        "strokeWidth": {
          "value": 1
        }
      }
    },
    {
      "name": "bad_area_border_actual",
      "transform": [
        {
          "filter": "isValid(datum.NextActual)"
        },
        {
          "flatten": [
            "Vertices"
          ],
          "as": [
            "Vertex"
          ]
        },
        {
          "calculate": "datum.Position + '-' + datum.Vertex.part",
          "as": "Segment"
        },
        {
          "filter": "!((datum.Business_Type == 'Higher is Good' && datum.Vertex.sign > 0) || (datum.Business_Type == 'Lower is Good' && datum.Vertex.sign < 0))"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#B45309",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          2
        ],
        "point": false,
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "Vertex.x",
          "type": "quantitative"
        },
        "y": {
          "field": "Vertex.actual",
          "type": "quantitative"
        },
        "detail": {
          "field": "Segment",
          "type": "nominal"
        }
      }
    },
    {
      "name": "bad_area_border_reference",
      "transform": [
        {
          "filter": "isValid(datum.NextActual)"
        },
        {
          "flatten": [
            "Vertices"
          ],
          "as": [
            "Vertex"
          ]
        },
        {
          "calculate": "datum.Position + '-' + datum.Vertex.part",
          "as": "Segment"
        },
        {
          "filter": "!((datum.Business_Type == 'Higher is Good' && datum.Vertex.sign > 0) || (datum.Business_Type == 'Lower is Good' && datum.Vertex.sign < 0))"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#B45309",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          2
        ],
        "point": false,
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "Vertex.x",
          "type": "quantitative"
        },
        "y": {
          "field": "Vertex.reference",
          "type": "quantitative"
        },
        "detail": {
          "field": "Segment",
          "type": "nominal"
        }
      }
    },
    {
      "name": "connector_rule",
      "mark": {
        "type": "rule",
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "Position",
          "type": "quantitative"
        },
        "y": {
          "field": "Actual",
          "type": "quantitative"
        },
        "y2": {
          "field": "Reference"
        },
        "color": {
          "condition": {
            "test": "(datum.Business_Type == 'Higher is Good' && datum.Actual > datum.Reference) || (datum.Business_Type == 'Lower is Good' && datum.Actual < datum.Reference)",
            "value": "#0F766E"
          },
          "value": "#B45309"
        },
        "strokeWidth": {
          "condition": {
            "test": "(datum.Business_Type == 'Higher is Good' && datum.Actual > datum.Reference) || (datum.Business_Type == 'Lower is Good' && datum.Actual < datum.Reference)",
            "value": 3
          },
          "value": 2
        }
      }
    },
    {
      "name": "line_reference",
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "color": "#F59E0B",
        "strokeWidth": 2,
        "strokeDash": [
          5,
          3
        ],
        "point": false,
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "Position",
          "type": "quantitative"
        },
        "y": {
          "field": "Reference",
          "type": "quantitative"
        }
      }
    },
    {
      "name": "line_actual",
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "color": "#2563EB",
        "strokeWidth": 2,
        "point": false,
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "Position",
          "type": "quantitative",
          "title": "เดือน",
          "axis": {
            "values": {
              "expr": "xAxisValues"
            },
            "labelExpr": "xAxisCategories[datum.value - 1]",
            "labelLimit": {
              "expr": "max(40, width / 3)"
            },
            "labelFlush": false,
            "labelSeparation": 4,
            "labelOverlap": "greedy",
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Actual",
          "type": "quantitative",
          "title": "ยอดขาย (พันบาท)",
          "scale": {
            "domain": [
              {
                "expr": "yDomainMin"
              },
              {
                "expr": "yDomainMax"
              }
            ],
            "zero": false,
            "nice": false
          }
        }
      }
    },
    {
      "name": "point_reference",
      "mark": {
        "type": "point",
        "filled": true,
        "size": 40,
        "color": "#F59E0B",
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "Position",
          "type": "quantitative"
        },
        "y": {
          "field": "Reference",
          "type": "quantitative"
        }
      }
    },
    {
      "name": "point_actual_hit_target",
      "mark": {
        "type": "point",
        "filled": true,
        "size": 40,
        "color": "#2563EB"
      },
      "encoding": {
        "x": {
          "field": "Position",
          "type": "quantitative"
        },
        "y": {
          "field": "Actual",
          "type": "quantitative"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "shared",
      "x": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domainColor": "#D1D5DB",
      "gridColor": "#F3F4F6"
    }
  }
}
