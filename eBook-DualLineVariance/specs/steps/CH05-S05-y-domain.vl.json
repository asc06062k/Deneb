{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Workshop step CH05-S05 - Y domain = data extent +/- 18% padding like the prototype (params + scale.domain expr), blank Actual/Reference = 0. Generated by qa/scripts/build-workshop-steps.mjs from specs/dual-line-variance-final.vl.json (do not hand-edit; edit the final spec or the generator).",
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "data": {
    "name": "dataset"
  },
  "params": [
    {
      "name": "xAxisCategories",
      "expr": "pluck(data('dataset'), 'Category')"
    },
    {
      "name": "xAxisValues",
      "expr": "length(xAxisCategories) > 0 && length(xAxisCategories) <= 1000 ? sequence(1, length(xAxisCategories) + 1) : []"
    },
    {
      "name": "yActualValues",
      "expr": "pluck(data('dataset'), 'Actual')"
    },
    {
      "name": "yReferenceValues",
      "expr": "pluck(data('dataset'), 'Reference')"
    },
    {
      "name": "yHasBlank",
      "expr": "indexof(yActualValues, null) >= 0 || indexof(yReferenceValues, null) >= 0"
    },
    {
      "name": "yRawMin",
      "expr": "min(extent(yActualValues)[0], extent(yReferenceValues)[0], yHasBlank ? 0 : MAX_VALUE)"
    },
    {
      "name": "yRawMax",
      "expr": "max(extent(yActualValues)[1], extent(yReferenceValues)[1], yHasBlank ? 0 : -MAX_VALUE)"
    },
    {
      "name": "yPad",
      "expr": "(yRawMax - yRawMin) * 0.18 || abs(yRawMax) * 0.1 || 1"
    },
    {
      "name": "yDomainMin",
      "expr": "isFinite(yRawMin) ? yRawMin - yPad : 0"
    },
    {
      "name": "yDomainMax",
      "expr": "isFinite(yRawMax) ? max(yRawMax + yPad, yDomainMin + 1) : 1"
    }
  ],
  "transform": [
    {
      "calculate": "isValid(datum.Actual) ? datum.Actual : 0",
      "as": "Actual"
    },
    {
      "calculate": "isValid(datum.Reference) ? datum.Reference : 0",
      "as": "Reference"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "Position"
        }
      ]
    }
  ],
  "layer": [
    {
      "name": "line_reference",
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "color": "#F59E0B",
        "strokeWidth": 2,
        "strokeDash": [
          5,
          3
        ],
        "point": false,
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "Position",
          "type": "quantitative"
        },
        "y": {
          "field": "Reference",
          "type": "quantitative"
        }
      }
    },
    {
      "name": "line_actual",
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "color": "#2563EB",
        "strokeWidth": 2,
        "point": false,
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "Position",
          "type": "quantitative",
          "title": "เดือน",
          "axis": {
            "values": {
              "expr": "xAxisValues"
            },
            "labelExpr": "xAxisCategories[datum.value - 1]",
            "labelLimit": {
              "expr": "max(40, width / 3)"
            },
            "labelFlush": false,
            "labelSeparation": 4,
            "labelOverlap": "greedy",
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Actual",
          "type": "quantitative",
          "title": "ยอดขาย (พันบาท)",
          "scale": {
            "domain": [
              {
                "expr": "yDomainMin"
              },
              {
                "expr": "yDomainMax"
              }
            ],
            "zero": false,
            "nice": false
          }
        }
      }
    },
    {
      "name": "point_reference",
      "mark": {
        "type": "point",
        "filled": true,
        "size": 40,
        "color": "#F59E0B",
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "Position",
          "type": "quantitative"
        },
        "y": {
          "field": "Reference",
          "type": "quantitative"
        }
      }
    },
    {
      "name": "point_actual_hit_target",
      "mark": {
        "type": "point",
        "filled": true,
        "size": 40,
        "color": "#2563EB"
      },
      "encoding": {
        "x": {
          "field": "Position",
          "type": "quantitative"
        },
        "y": {
          "field": "Actual",
          "type": "quantitative"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "shared",
      "x": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domainColor": "#D1D5DB",
      "gridColor": "#F3F4F6"
    }
  }
}
