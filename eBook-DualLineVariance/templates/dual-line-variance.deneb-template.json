  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Dual-Line Variance Chart - final Deneb-ready spec (rev 8, 4-field architecture, user decision 26 Sep 2026). Binds to {\"data\": {\"name\": \"dataset\"}} with ONLY four fields: Category, Actual, Reference (Sum measures renamed to plain names) and Business_Type (measure returning 'Higher is Good' or 'Lower is Good'). Row order = the order Deneb receives (Sort by column on Category). The variance-area vertices (start, crossing point, end of every month-to-month segment) are derived inside the spec: top-level window + calculate transforms, then flatten inside the area layers. Blank Actual/Reference are treated as 0 (like the prototype). Earlier revisions: rev 7 x-axis labelFlush false + labelLimit width/3 + labelSeparation 4; rev 6 x-axis labels read Category from the dataset; rev 5 highlight dims points 0.5, data labels 0.3, connector 0.2, lines never dim (user request); rev 4 highlight rule per real Deneb evidence (status on + __highlight null for non-highlighted rows); rev 3 Y domain = data extent +/- 18% padding like the dualLineVarianceChart prototype. For static/browser testing the test scripts inject inline data.values; this file intentionally has NO inline values so it is not accidentally pasted into Deneb with stale test data.",
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "data": {
    "name": "dataset"
  },
  "params": [
    {
      "name": "xAxisCategories",
      "expr": "pluck(data('dataset'), '__dataset.0__')"
    },
    {
      "name": "xAxisValues",
      "expr": "length(xAxisCategories) > 0 && length(xAxisCategories) <= 1000 ? sequence(1, length(xAxisCategories) + 1) : []"
    },
    {
      "name": "yActualValues",
      "expr": "pluck(data('dataset'), '__dataset.1__')"
    },
    {
      "name": "yReferenceValues",
      "expr": "pluck(data('dataset'), '__dataset.2__')"
    },
    {
      "name": "yHasBlank",
      "expr": "indexof(yActualValues, null) >= 0 || indexof(yReferenceValues, null) >= 0"
    },
    {
      "name": "yRawMin",
      "expr": "min(extent(yActualValues)[0], extent(yReferenceValues)[0], yHasBlank ? 0 : MAX_VALUE)"
    },
    {
      "name": "yRawMax",
      "expr": "max(extent(yActualValues)[1], extent(yReferenceValues)[1], yHasBlank ? 0 : -MAX_VALUE)"
    },
    {
      "name": "yPad",
      "expr": "(yRawMax - yRawMin) * 0.18 || abs(yRawMax) * 0.1 || 1"
    },
    {
      "name": "yDomainMin",
      "expr": "isFinite(yRawMin) ? yRawMin - yPad : 0"
    },
    {
      "name": "yDomainMax",
      "expr": "isFinite(yRawMax) ? max(yRawMax + yPad, yDomainMin + 1) : 1"
    }
  ],
  "transform": [
    {
      "calculate": "isValid(datum['__dataset.1__']) ? datum['__dataset.1__'] : 0",
      "as": "__dataset.1__"
    },
    {
      "calculate": "isValid(datum['__dataset.2__']) ? datum['__dataset.2__'] : 0",
      "as": "__dataset.2__"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "Position"
        }
      ]
    },
    {
      "window": [
        {
          "op": "lead",
          "field": "__dataset.1__",
          "as": "NextActual"
        },
        {
          "op": "lead",
          "field": "__dataset.2__",
          "as": "NextReference"
        }
      ]
    },
    {
      "calculate": "datum['__dataset.1__'] - datum['__dataset.2__']",
      "as": "Diff"
    },
    {
      "calculate": "datum.NextActual - datum.NextReference",
      "as": "NextDiff"
    },
    {
      "calculate": "datum.Diff != 0 ? (datum.Diff > 0 ? 1 : -1) : (datum.NextDiff > 0 ? 1 : datum.NextDiff < 0 ? -1 : 0)",
      "as": "RunSign"
    },
    {
      "calculate": "datum.Diff * datum.NextDiff < 0 ? datum.Diff / (datum.Diff - datum.NextDiff) : 0",
      "as": "CrossT"
    },
    {
      "calculate": "datum['__dataset.1__'] + datum.CrossT * (datum.NextActual - datum['__dataset.1__'])",
      "as": "CrossY"
    },
    {
      "calculate": "datum.CrossT > 0 ? [ {x: datum.Position, actual: datum['__dataset.1__'], reference: datum['__dataset.2__'], part: 'a', sign: datum.RunSign}, {x: datum.Position + datum.CrossT, actual: datum.CrossY, reference: datum.CrossY, part: 'a', sign: datum.RunSign}, {x: datum.Position + datum.CrossT, actual: datum.CrossY, reference: datum.CrossY, part: 'b', sign: -datum.RunSign}, {x: datum.Position + 1, actual: datum.NextActual, reference: datum.NextReference, part: 'b', sign: -datum.RunSign} ] : [ {x: datum.Position, actual: datum['__dataset.1__'], reference: datum['__dataset.2__'], part: '', sign: datum.RunSign}, {x: datum.Position + 1, actual: datum.NextActual, reference: datum.NextReference, part: '', sign: datum.RunSign} ]",
      "as": "Vertices"
    }
  ],
  "layer": [
